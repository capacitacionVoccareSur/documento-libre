# URL de la aplicación web de Apps Script que registra cada documento generado
# en Google Sheets (ver apps-script/Registro.gs). Vacía = no se registra nada.
NEXT_PUBLIC_REGISTRO_URL=
# Cliente OAuth de Google (tipo "Aplicación web") para crear el documento en Google Docs.
# Vacío: el botón Google Docs copia el documento para pegarlo a mano.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
